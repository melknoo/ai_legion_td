{
  "name": "legion-pixel-desktop",
  "productName": "Legion Pixel",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel tower defense with lanes, sends and kings. Solo against bots or online.",
  "author": "Legion Pixel",
  "main": "src/main.cjs",
  "scripts": {
    "build:client": "npm run build -w @legion/client --prefix .. -- --mode desktop --outDir ../desktop/app --emptyOutDir",
    "start": "npm run build:client && electron .",
    "dist": "npm run build:client && electron-builder --win nsis portable",
    "dist:dir": "npm run build:client && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.9.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "de.schleiweb.legionpixel",
    "productName": "Legion Pixel",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "app/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "app/icons/icon-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LegionPixel-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LegionPixel-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "app/icons/icon-512.png",
      "target": [
        "dir"
      ]
    },
    "publish": null
  }
}
